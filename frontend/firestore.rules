rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    // Retired games: old clients must not create or modify games.
    match /games/{gameId} { allow read: if true; allow write: if false; }
    match /courts/{courtId} { allow read: if true; allow write: if false; }
    match /sportTypes/{id} { allow read: if true; allow write: if false; }
    match /footballBookings/{gameId} {
      function signedIn() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }
      function capacity(d) { return d.pitchId == 'pitch3' ? 5 : 6; }
      function validSlot(d) {
        return d.keys().hasOnly(['startTime', 'pitchId', 'bookings', 'counts'])
          && d.pitchId in ['pitch1', 'pitch2', 'pitch3']
          && d.startTime is timestamp
          && d.startTime > request.time
          && d.startTime < request.time + duration.value(8, 'd')
          && (d.startTime.time() == duration.value(12, 'h')
            || d.startTime.time() == duration.value(13, 'h'))
          && gameId == string(int(d.startTime.toMillis() / 1000)) + '_' + d.pitchId
          && d.bookings is map && d.counts is map
          && d.counts.keys().hasAll(['red', 'blue', 'yellow', 'green'])
          && d.counts.keys().hasOnly(['red', 'blue', 'yellow', 'green']);
      }
      function validName(names, i) {
        return names.size() <= i || (names[i] is string && names[i].size() <= 80);
      }
      function validPosition(position) {
        return position in ['any', 'goalkeeper', 'defender', 'midfielder', 'forward'];
      }
      function validFriendPosition(positions, i) {
        return positions.size() <= i || validPosition(positions[i]);
      }
      function validFriendPositions(b) {
        let positions = b.get('friendPositions', []);
        return positions is list && positions.size() <= b.places - 1
          && validFriendPosition(positions, 0) && validFriendPosition(positions, 1)
          && validFriendPosition(positions, 2) && validFriendPosition(positions, 3)
          && validFriendPosition(positions, 4);
      }
      function validBooking(b, cap) {
        return b is map
          && b.keys().hasAll(['team', 'places', 'bookerName', 'friendNames'])
          && b.keys().hasOnly(['team', 'places', 'bookerName', 'friendNames', 'position', 'friendPositions'])
          && b.team in ['red', 'blue', 'yellow', 'green']
          && b.places is int && b.places >= 1 && b.places <= cap
          && b.bookerName is string && b.bookerName.size() > 0 && b.bookerName.size() <= 80
          && b.bookerName.matches('.*[^ ].*')
          && b.friendNames is list && b.friendNames.size() <= b.places - 1
          && validName(b.friendNames, 0) && validName(b.friendNames, 1)
          && validName(b.friendNames, 2) && validName(b.friendNames, 3)
          && validName(b.friendNames, 4)
          && validPosition(b.get('position', 'any')) && validFriendPositions(b);
      }
      function places(b, team) { return b.get('team', '') == team ? b.places : 0; }
      function countValid(d, oldCounts, before, after, team) {
        return d.counts[team] is int && d.counts[team] >= 0
          && d.counts[team] <= capacity(d)
          && d.counts[team] == oldCounts.get(team, 0)
            - places(before, team) + places(after, team);
      }
      function validChange(d, oldBookings, oldCounts) {
        let uid = request.auth.uid;
        let before = oldBookings.get(uid, {});
        let after = d.bookings.get(uid, {});
        return d.bookings.diff(oldBookings).affectedKeys().hasOnly([uid])
          && (!(uid in d.bookings) || validBooking(after, capacity(d)))
          && (!(uid in oldBookings) || !(uid in d.bookings) || before.team == after.team)
          && countValid(d, oldCounts, before, after, 'red')
          && countValid(d, oldCounts, before, after, 'blue')
          && countValid(d, oldCounts, before, after, 'yellow')
          && countValid(d, oldCounts, before, after, 'green');
      }
      // Public roster: display names and position preferences, no contact or payment information.
      allow read: if true;
      allow create: if signedIn() && validSlot(request.resource.data)
        && request.auth.uid in request.resource.data.bookings
        && validChange(request.resource.data, {}, {});
      allow update: if signedIn() && validSlot(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookings', 'counts'])
        && validChange(request.resource.data, resource.data.bookings, resource.data.counts);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
