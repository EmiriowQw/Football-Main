{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "football-day",
          "appId": "1:1044539186696:android:2adc7f40fe48a26a8ebbbd",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "football-day",
          "appId": "1:1044539186696:ios:6e10d14a7a5f11d18ebbbd",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "football-day",
          "configurations": {
            "android": "1:1044539186696:android:2adc7f40fe48a26a8ebbbd",
            "ios": "1:1044539186696:ios:6e10d14a7a5f11d18ebbbd",
            "web": "1:1044539186696:web:81d39bc45adac1168ebbbd"
          }
        }
      }
    }
  }
}
